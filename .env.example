PROJECT_NAME=aviation-weather-disruption

JUPYTER_TOKEN=change-me
# Optional: match Jupyter's runtime user to the VM user so notebook saves
# from the container persist directly to the repo bind mount.
HOST_UID=1002
HOST_GID=1005

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT_INTERNAL=http://minio:9000
MINIO_ENDPOINT_EXTERNAL=http://localhost:9000

AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_WEATHER_RAW=weather.raw
KAFKA_REPLAY_MAX_RECORDS=240
KAFKA_REPLAY_DELAY_SECONDS=0.03
KAFKA_CONSUMER_FLUSH_SIZE=50
KAFKA_CONSUMER_QUIET_SECONDS=30

RAW_BUCKET=raw
LAKEHOUSE_BUCKET=lakehouse
WAREHOUSE_BUCKET=warehouse

SPARK_MASTER_URL=spark://spark-master:7077
SPARK_EXECUTOR_MEMORY=3g
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=16
SPARK_WORK_DIR=/tmp/spark-work-1002
SPARK_LOCAL_DIR=/tmp/spark-local-1002

MLFLOW_TRACKING_URI=http://mlflow:5000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional LLM assistant for final demo Q&A.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
